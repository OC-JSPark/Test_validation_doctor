# 전문의 평가 시스템 환경변수 템플릿
# 사용법: cp .env.example .env  후 실제 값으로 채우기
# .env 는 절대 커밋하지 않습니다.

# ---------- 신규 로컬 평가 DB (docker-compose.yml 의 test-db) ----------
# 기존 서비스 DB(aimie_kids_app / aimie_kids_ai) 와 분리된 별도 데이터베이스다.
# 루트 .env 의 DATABASE_URL 과 이름이 겹치지 않도록 전용 키를 쓴다.
VALIDATION_DATABASE_URL=postgresql://aimieapi:aimieapi@localhost:15432/validation_db

# ---------- 학생 명부 DB (읽기 전용) ----------
# 관리자 화면의 학생 선택 목록을 여기서 읽는다. 커넥션은 read_only 로 열린다.
# 지금은 로컬에 복원된 aimie_kids_app, 추후 인스턴스 DB 로 바꿀 때 이 값만 교체한다.
STUDENT_SOURCE_DATABASE_URL=postgresql://aimieapi:aimieapi@localhost:15432/aimie_kids_app

# ---------- 외부 서비스 API (Read-only) ----------
# 관리자 API 호스트. dev.aimie-m.com 은 nginx 테스트 페이지만 떠 있어 404 가 난다.
EXTERNAL_API_BASE_URL=https://admin-dev.aimie-m.com
EXTERNAL_API_TIMEOUT=10

# 게이트웨이 프리픽스가 바뀌면 경로만 여기서 조정한다 (비우면 기본값 사용).
EXTERNAL_API_LOGIN_PATH=/api-kids/adm/login
EXTERNAL_API_CHAT_PATH=/api-kids/risk-students/student/chat
EXTERNAL_API_LOGIN_TYPE=TEACHER

# 아래 둘 중 하나를 채운다.
# (A) 이미 발급받은 accessToken 을 그대로 쓰는 경우
EXTERNAL_API_TOKEN=
# (B) 앱이 로그인 API 로 직접 토큰을 받는 경우 (권장 — 만료 시 자동 재발급)
EXTERNAL_API_LOGIN_ID=여기에-로그인ID
EXTERNAL_API_PASSWORD=여기에-비밀번호

# ---------- 평가 선택지 (콤마 구분, 비우면 기본값 사용) ----------
DOCTOR_SCORE_OPTIONS=Not at all (1점),Slightly (2점),Moderately (3점),Very (4점),Extremely (5점)
SCALE_STAGE_OPTIONS=1단계 KIDSCREEN-10,2단계 PHQ-9,3단계 GAD-7

# ---------- 초기 계정 시드 (scripts/init_db.py --seed) ----------
# 운영에서는 반드시 바꾼다.
SEED_ADMIN_PASSWORD=admin1234
SEED_DOCTOR_PASSWORD=doctor1234
SEED_DOCTOR_COUNT=3
