# 전문의 평가 시스템 환경변수 템플릿
# 사용법: cp .env.example .env  후 실제 값으로 채우기
# .env 는 절대 커밋하지 않습니다.
#
# ┌─ 서버(dev/stg) ─ [1]~[3] 만 채운다. DB 주소는 SSM 에서 온다.
# └─ 로컬 개발     ─ [4] 블록의 주석을 푼다.


# ═══════════════════════════════════════════════════════════════
# [1] DB 접속 정보 출처
# ═══════════════════════════════════════════════════════════════
# aws (기본) : AWS SSM Parameter Store 에서 가져온다  → 서버
# env        : [4] 블록의 *_DATABASE_URL 을 쓴다      → 로컬 개발
#
# 서버에서는 DB 주소를 이 파일에 적지 않는다. 파일이 유출되면 DB 3개가
# 한꺼번에 노출되고, 비밀번호를 바꿀 때 서버마다 파일을 고쳐야 한다.
SECRETS_BACKEND=aws

# SSM 경로가 /aimie/{ENV}/... 형태라 ENV 가 필요하다.
ENV=dev
AWS_REGION=ap-northeast-2

# 필요한 SSM 파라미터 (app/secret_loader.py 참고)
#   /aimie/{ENV}/DB_HOST             공통 호스트         (필수)
#   /aimie/{ENV}/DB_PORT             공통 포트           (필수)
#   /aimie/{ENV}/DB_USER             공통 사용자         (필수)
#   /aimie/DB_PASS                   공통 비밀번호       (필수, 환경 무관)
#   /aimie/{ENV}/DB_NAME             학생 명부 DB 이름   (필수)
#   /aimie/{ENV}/AI_DB_NAME          척도검사 DB 이름    (필수)
#   /aimie/{ENV}/VALIDATION_DB_NAME  평가 DB 이름        (없으면 validation_db)
#   /aimie/{ENV}/DB_RO_USER          읽기 전용 계정      (없으면 공통 계정)
#   /aimie/{ENV}/DB_RO_PASS          읽기 전용 비밀번호  (없으면 공통 비밀번호)


# ═══════════════════════════════════════════════════════════════
# [2] 외부 대화 API (읽기 전용)
# ═══════════════════════════════════════════════════════════════
# dev.aimie-m.com 은 nginx 테스트 페이지만 떠 있어 404 가 난다. admin-dev 를 쓸 것.
EXTERNAL_API_BASE_URL=https://admin-dev.aimie-m.com
EXTERNAL_API_TIMEOUT=10

# 게이트웨이 프리픽스가 바뀌면 경로만 여기서 조정한다 (비우면 기본값 사용).
EXTERNAL_API_LOGIN_PATH=/api-kids/adm/login
EXTERNAL_API_CHAT_PATH=/api-kids/risk-students/student/chat
EXTERNAL_API_LOGIN_TYPE=TEACHER

# 아래 둘 중 하나를 채운다.
# (A) 이미 발급받은 accessToken 을 그대로 쓰는 경우
EXTERNAL_API_TOKEN=
# (B) 앱이 로그인 API 로 직접 토큰을 받는 경우 (권장 — 만료 시 자동 재발급)
EXTERNAL_API_LOGIN_ID=여기에-로그인ID
EXTERNAL_API_PASSWORD=여기에-비밀번호


# ═══════════════════════════════════════════════════════════════
# [3] 평가 선택지 · 계정
# ═══════════════════════════════════════════════════════════════
# 기본 척도 점수(5점). PHQ-stress 는 코드에서 0~2점 3점 척도를 따로 쓴다.
DOCTOR_SCORE_OPTIONS=Not at all (0점),Slightly (1점),Moderately (2점),Very (3점),Extremely (4점)
SCALE_STAGE_OPTIONS=1단계 PHQ-stress,2단계 PHQ-2,3단계 PHQ-A

# 전문의 계정 수
SEED_DOCTOR_COUNT=10

# 계정 비밀번호는 여기 두지 않는다. 서버 파일에 평문으로 남기 때문이다.
#   uv run python -m scripts.init_db --seed          → 계정마다 난수 발급, 1회 출력
#   uv run python -m scripts.init_db --seed --prompt → 직접 입력
#   분실 시: --seed --force 로 재발급


# ═══════════════════════════════════════════════════════════════
# [4] 로컬 개발 전용 — 서버에서는 건드리지 말 것
# ═══════════════════════════════════════════════════════════════
# 로컬에서는 AWS 자격증명 없이 docker 의 PostgreSQL 을 그대로 쓴다.
# 위 SECRETS_BACKEND=aws 를 지우고 아래 네 줄의 주석을 푼다.
#
# SECRETS_BACKEND=env
# VALIDATION_DATABASE_URL=postgresql://aimieapi:aimieapi@localhost:15432/validation_db
# STUDENT_SOURCE_DATABASE_URL=postgresql://aimieapi:aimieapi@localhost:15432/aimie_kids_dev_app
# SESSION_SOURCE_DATABASE_URL=postgresql://aimieapi:aimieapi@localhost:15432/aimie_kids_dev_ai
#
# 비밀번호를 고정하고 싶을 때만 (계정 공통이 되므로 서버에서는 쓰지 말 것)
# SEED_ADMIN_PASSWORD=
# SEED_DOCTOR_PASSWORD=
